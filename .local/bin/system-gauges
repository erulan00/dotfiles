#!/usr/bin/env bash

set -u

# eww system-gauges 用の極軽メータ。
# PNGの実レンダリングは常駐デーモン system-gauges-render が10Hzで行い、
# 本スクリプトは「最新の完成済みPNGのパス」を返すだけ。
# (flip ファイルはレンダラが完了したパスのID: 0=/_a 1=/_b)

runtime="${XDG_RUNTIME_DIR:-/tmp}/eww-system-gauges"

flip=0
[[ -r "$runtime/flip" ]] && read -r flip < "$runtime/flip" 2>/dev/null

target="$runtime/gauge_a.png"
if [[ "${flip:-0}" == 1 && -r "$runtime/gauge_b.png" ]]; then
    target="$runtime/gauge_b.png"
fi

printf '%s\n' "$target"
