#!/usr/bin/env bash

set -u

# eww system-gauges 用のリングゲージ(CPU / RAM / VRAM)を描画し、
# 表示するPNGのパスを標準出力する。
# i3barは画像を表示できないため、バーと同色・同高さ(25px)のストリップを
# バーの上に重ねて表示する。eww側の再描画検知のため、
# 2つのPNGファイルを交互に切り替えて出力する。

runtime="${XDG_RUNTIME_DIR:-/tmp}/eww-system-gauges"
mkdir -p "$runtime"

# dotfiles / eww lockscreen palette
TRACK="#4C566A"

CPU_BASE="#FFB300"
RAM_BASE="#ffd5cd"
VRAM_BASE="#A3BE8C"

WARNING="#D08770"
CRITICAL="#BF616A"
TEXT="#ECEFF4"
SUB="#D8DEE9"
DIM="#4C566A"

# --------------------------------------------------
# CPU usage (2回連続実行の差分から算出)
# --------------------------------------------------

read -r _ user nice system idle iowait irq softirq steal _ < /proc/stat

idle_now=$((idle + iowait))
total_now=$((user + nice + system + idle + iowait + irq + softirq + steal))

state="$runtime/cpu.state"

cpu=0

if [[ -r "$state" ]]; then
    read -r total_old idle_old < "$state"

    total_delta=$((total_now - total_old))
    idle_delta=$((idle_now - idle_old))

    if (( total_delta > 0 )); then
        cpu=$((100 * (total_delta - idle_delta) / total_delta))
    fi
fi

printf '%s %s\n' "$total_now" "$idle_now" > "$state"

# --------------------------------------------------
# RAM usage
# --------------------------------------------------

read -r mem_total mem_available < <(
    awk '
        /^MemTotal:/     { total=$2 }
        /^MemAvailable:/ { available=$2 }
        END { print total, available }
    ' /proc/meminfo
)

ram=$((100 * (mem_total - mem_available) / mem_total))

# --------------------------------------------------
# VRAM usage (nvidia-smi)
# --------------------------------------------------

vram=-1

if command -v nvidia-smi >/dev/null 2>&1; then
    read -r mem_used mem_total_gpu < <(
        nvidia-smi \
            --query-gpu=memory.used,memory.total \
            --format=csv,noheader,nounits 2>/dev/null | head -n1 | tr ',' ' '
    )

    if [[ -n "${mem_total_gpu:-}" && "$mem_total_gpu" =~ ^[0-9]+$ ]] && (( mem_total_gpu > 0 )); then
        vram=$((100 * mem_used / mem_total_gpu))
    fi
fi

# --------------------------------------------------
# 正規化(範囲外・取得不可値の処理)
# --------------------------------------------------

cramp() {
    local value="$1"

    (( value < 0 )) && value=0
    (( value > 100 )) && value=100
    printf '%s' "$value"
}

usage_color() {
    local value="$1"
    local base="$2"

    if (( value >= 85 )); then
        printf '%s' "$CRITICAL"
    elif (( value >= 70 )); then
        printf '%s' "$WARNING"
    else
        printf '%s' "$base"
    fi
}

pct_text() {
    printf '%d%%' "$1"
}

arc_dash() {
    awk -v usage="$1" 'BEGIN { printf "%.2f", 64.088 * 0.75 * usage / 100 }'
}

cpu="$(cramp "$cpu")"
ram="$(cramp "$ram")"
vram="$(cramp "$vram")"

# --------------------------------------------------
# SVG生成
# バー内蔵風ストリップ: 100x25px, 背景はバーと同一の #282828
# リング: 外径約24px, 線幅3.4, ゲージ範囲は270度(左下135度から時計回りに右下45度まで)
# 文字は載せない(ユーザー指定)
# --------------------------------------------------

gauge_svg() {
    local cx="$1" usage="$2" value_color="$3"
    local dash

    dash="$(arc_dash "$usage")"

    cat <<EOF
<g>
  <circle cx="${cx}" cy="12.5" r="10.2" fill="none"
          stroke="${TRACK}" stroke-width="3.4"
          stroke-dasharray="48.07 64.09" stroke-linecap="round"
          transform="rotate(135 ${cx} 12.5)" />
  <circle cx="${cx}" cy="12.5" r="10.2" fill="none"
          stroke="${value_color}" stroke-width="3.4"
          stroke-dasharray="${dash} 64.09" stroke-linecap="round"
          transform="rotate(135 ${cx} 12.5)" />
</g>
EOF
}

svg_emit() {
    cat <<EOF
<svg xmlns="http://www.w3.org/2000/svg" width="100" height="25" viewBox="0 0 100 25">
  <rect x="0" y="0" width="100" height="25" fill="#282828" />
  $(gauge_svg 15 "$cpu" "$(usage_color "$cpu" "$CPU_BASE")")
  $(gauge_svg 50 "$ram" "$(usage_color "$ram" "$RAM_BASE")")
  $(gauge_svg 85 "$vram" "$(usage_color "$vram" "$VRAM_BASE")")
</svg>
EOF
}

# --------------------------------------------------
# PNG描画と交互パス出力
# --------------------------------------------------

toggle="$runtime/flip"
flip=0
[[ -r "$toggle" ]] && flip=$(< "$toggle")
flip=$(( (flip + 1) % 2 ))
printf '%s\n' "$flip" > "$toggle"

target="$runtime/gauge_a.png"
(( flip == 1 )) && target="$runtime/gauge_b.png"

svg_emit > "$runtime/gauge.svg"

# SVGはcairosvgでPNG化する(rsvg等のpixbufローダーが無い環境向けフォールバック付き)
pydir="$HOME/.local/share/system-gauges-python"

if [[ -x "$(command -v python3)" && -d "$pydir" ]]; then
    PYTHONPATH="$pydir" python3 - "$runtime/gauge.svg" "$target" <<'PY'
import sys
import cairosvg

cairosvg.svg2png(
    url=sys.argv[1],
    write_to=sys.argv[2],
    output_width=100,
    output_height=25,
)
PY
else
    convert -background none "$runtime/gauge.svg" "$target"
fi

printf '%s\n' "$target"
