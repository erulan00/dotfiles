#!/usr/bin/env bash
set -euo pipefail

SRC="/usr/share/i3xrocks/conf.d"
DST="$HOME/.config/regolith3/i3xrocks/conf.d"

mkdir -p "$DST"

# 現在インストールされているRegolith blockletを引き継ぐ
for file in "$SRC"/*; do
    [[ -f "$file" ]] || continue

    name="$(basename "$file")"

# CPU / RAM / VRAM は eww system-gauges オーバーレイ(リングゲージ)に置換したため、
# i3xrocks系のCPU / RAM系blockletは導入しない。
case "$name" in
    40_cpu-usage|50_memory|40_system-load)
        continue
        ;;
esac

# ユーザー変更済みなら上書きしない
[[ -e "$DST/$name" ]] || cp "$file" "$DST/$name"
done

# 旧CPU / RAM系blocklet設定があれば除去
rm -f \
    "$DST/40_cpu-usage" \
    "$DST/50_memory" \
    "$DST/40_system-load"

regolith-look refresh >/dev/null 2>&1 || true