#!/usr/bin/env python3
"""バー用ストリップ [ジャケット][CPU/RAM/VRAM リング][再生中曲名][スペアナ] を20Hzで描画する。

eww は defpoll で ~/.local/bin/system-gauges (flip読みのみの極軽メータ) を
叩き、本デーモンが書き込む gauge_a.png / gauge_b.png を表示する。
PNGはテンポラリ→os.replace のアトミック書き込み。
"""

import base64
import fcntl
import html
import math
import os
import subprocess
import sys
import threading
import time

runtime = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "eww-system-gauges")
os.makedirs(runtime, exist_ok=True)

lockfile = open(os.path.join(runtime, "lock"), "w")
try:
    fcntl.flock(lockfile, fcntl.LOCK_EX | fcntl.LOCK_NB)
except OSError:
    sys.exit(0)  # 既に別インスタンスが動いている

with open(os.path.join(runtime, "pid"), "w") as f:
    f.write(str(os.getpid()))

# --------------------------------------------------
# 設定 / パレット
# --------------------------------------------------

W, H = 464, 25
CY = H / 2

BG = "#282828"
TRACK = "#4C566A"
CPU_BASE = "#FFB300"
RAM_BASE = "#FFD5CD"
VRAM_BASE = "#A3BE8C"
WARNING = "#D08770"
CRITICAL = "#BF616A"
TITLE_COL = "#D8DEE9"
ARTIST_COL = "#9AA5B1"
PLAY_COL = "#FFB300"
PAUSE_COL = "#6E7681"
WAVE_IDLE_COL = "#3B4252"

CIRC = 64.088

# ジャケット絵
ART_X, ART_Y, ART_SIZE = 2.0, 2.0, 21.0

# 並び(左→右): ジャケット, 曲名, スペアナ, リング → (この右にネット速度, 時計)
BAR_W, N_BANDS = 6.6, 24
WAVE_X = 170.0
SPECTRUM_W = 185.0
ICON_X = 29.0
TEXT_X = 45.0
# タイトル表示領域は以前の半分(119px)。文字はマーキーで流す。
TITLE_END = 164.0
MARQUEE_GAP = 14.0
MARQUEE_SPEED = 30.0  # px/s

# マーキー状態: 曲が変わったら右端から流れ込ませる
marquee_key = None
marquee_start = 0.0

# スペアナのバー配置(170..355 を 24 本)
BAR_PITCH = SPECTRUM_W / N_BANDS
SPECTRUM_BOTTOM = 22.0

CHAR_W = 6.95
WIDE_W = 13.8
NARROW_W = 4.2

NARROW_CHARS = set("iIlj.,'`|!-")

wave_samples_path = os.path.join(
    os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "regolith-wave", "samples"
)


def clamp(v, lo=0.0, hi=1.0):
    return max(lo, min(hi, v))


def usage_color(value, base):
    if value >= 85:
        return CRITICAL
    if value >= 70:
        return WARNING
    return base


# --------------------------------------------------
# 値の取得
# --------------------------------------------------

class CpuMeter:
    def __init__(self, state_path):
        self.state_path = state_path
        self.prev = None
        try:
            with open(state_path) as f:
                self.prev = tuple(float(x) for x in f.read().split())
        except (OSError, ValueError):
            self.prev = None

    def read(self):
        try:
            with open("/proc/stat") as f:
                fields = f.readline().split()[1:10]
            user_, nice_, sys_, idle_, iowait_, irq_, softirq_, steal_ = (
                float(x) for x in fields[:8]
            )
            idle = idle_ + iowait_
            total = user_ + nice_ + sys_ + idle + irq_ + softirq_ + steal_
        except (OSError, ValueError, IndexError):
            return None
        prev = self.prev
        self.prev = (total, idle)
        with open(self.state_path, "w") as f:
            f.write(f"{total} {idle}\n")
        if prev is None:
            return 0.0
        d_total, d_idle = total - prev[0], idle - prev[1]
        if d_total <= 0:
            return None
        return clamp(100 * (d_total - d_idle) / d_total, 0.0, 100.0)


class Cached:
    def __init__(self, ttl, fn):
        self.ttl, self.fn, self.at, self.value = ttl, fn, 0.0, None

    def get(self, now):
        if now - self.at >= self.ttl or self.value is None:
            self.at = now
            self.value = self.fn(now)
        return self.value


def read_ram():
    try:
        total = avail = None
        with open("/proc/meminfo") as f:
            for line in f:
                if line.startswith("MemTotal:"):
                    total = int(line.split()[1])
                elif line.startswith("MemAvailable:"):
                    avail = int(line.split()[1])
            if not total or avail is None:
                return 0.0
            return clamp(100 * (total - avail) / total, 0.0, 100.0)
    except (OSError, ValueError):
        return 0.0


def read_vram(_now):
    try:
        out = subprocess.run(
            ["nvidia-smi", "--query-gpu=memory.used,memory.total",
             "--format=csv,noheader,nounits"],
            capture_output=True, text=True, timeout=3,
        ).stdout
        used, total = out.split()[0], out.split()[1]
        total = int(total)
        if total > 0:
            return clamp(100 * int(used) / total, 0.0, 100.0)
    except (OSError, ValueError, IndexError, subprocess.SubprocessError):
        pass
    return 0.0


def read_media(_now):
    try:
        return subprocess.run(
            ["playerctl", "metadata", "--format",
             "{{status}}|{{title}}|{{artist}}|{{mpris:artUrl}}"],
            capture_output=True, text=True, timeout=2,
        ).stdout.strip()
    except (OSError, subprocess.SubprocessError):
        return ""


art_url_seen = None
art_b64 = (None, None)


def _fetch_art(url):
    """mpris:artUrl を取得して 42x42 のPNGに変換する(別スレッド)."""
    path = os.path.join(runtime, "art.png")
    tmp = path + ".tmp"
    src = os.path.join(runtime, "art.src")
    try:
        if url.startswith("file://"):
            subprocess.run(
                ["convert", url[7:], "-resize", "42x42^", "-gravity", "center",
                 "-extent", "42x42", "-strip", tmp],
                check=True, timeout=8, capture_output=True,
            )
        else:
            subprocess.run(
                ["curl", "-sL", "--max-time", "6", "-o", src, url],
                check=True, timeout=10, capture_output=True,
            )
            subprocess.run(
                ["convert", src, "-resize", "42x42^", "-gravity", "center",
                 "-extent", "42x42", "-strip", tmp],
                check=True, timeout=8, capture_output=True,
            )
        os.replace(tmp, path)
    except (OSError, subprocess.SubprocessError):
        try:
            os.remove(tmp)
        except OSError:
            pass


def art_data_uri():
    """art.png を data URI 化する (mtime でキャッシュ)."""
    global art_b64
    path = os.path.join(runtime, "art.png")
    try:
        st = os.stat(path)
    except OSError:
        return None
    if art_b64[0] != st.st_mtime_ns:
        with open(path, "rb") as f:
            art_b64 = (
                st.st_mtime_ns,
                "data:image/png;base64," + base64.b64encode(f.read()).decode(),
            )
    return art_b64[1]


def read_spectrum(now):
    """直近の複数フレームを平均したバンドレベルを返す(なめらかさ優先)。"""
    try:
        with open(wave_samples_path) as f:
            lines = f.readlines()
    except OSError:
        return None
    rows = []
    for line in lines[-60:]:
        parts = line.split()
        if len(parts) != N_BANDS + 1:
            continue
        try:
            ts = float(parts[0])
            vals = [clamp(float(v)) for v in parts[1:]]
        except ValueError:
            continue
        rows.append((ts, vals))
    if not rows:
        return None
    rows.sort()
    newest = rows[-1][0]
    if now - newest > 3.0:
        return None
    recent = [v for ts, v in rows if ts >= newest - 0.24]
    n = len(recent)
    return [sum(col) / n for col in zip(*recent)]


# --------------------------------------------------
# SVG 生成 (リング / メディア / 波形)
# --------------------------------------------------

def ring(cx, usage, color):
    vis = f"{CIRC * 0.75 * usage / 100:.2f}"
    return (
        f'<g><circle cx="{cx}" cy="{CY}" r="10.2" fill="none" stroke="{TRACK}" '
        f'stroke-width="3.4" stroke-dasharray="48.07 {CIRC:.2f}" '
        f'stroke-linecap="round" transform="rotate(135 {cx} {CY})"/>'
        f'<circle cx="{cx}" cy="{CY}" r="10.2" fill="none" stroke="{color}" '
        f'stroke-width="3.4" stroke-dasharray="{vis} {CIRC:.2f}" '
        f'stroke-linecap="round" transform="rotate(135 {cx} {CY})"/></g>'
    )


def char_w(ch):
    o = ord(ch)
    if (
        0x1100 <= o <= 0x115F
        or 0x2E80 <= o <= 0xA4CF
        or 0xAC00 <= o <= 0xD7A3
        or 0xF900 <= o <= 0xFAFF
        or 0xFE30 <= o <= 0xFE6F
        or 0xFF00 <= o <= 0xFF60
        or 0xFFE0 <= o <= 0xFFE6
        or o >= 0x1F300
    ):
        return WIDE_W
    if ch in NARROW_CHARS:
        return NARROW_W
    return CHAR_W


def text_w(s):
    return sum(char_w(c) for c in s)


def media_parts(status, title, artist, now):
    """(icon_svg, text_svg) を返す。テキストは幅超過時にマーキーで流れる。"""
    global marquee_key, marquee_start

    if not status:
        marquee_key = None
        return "", ""

    key = title + "\x00" + artist
    if key != marquee_key:
        marquee_key = key
        marquee_start = now
    if status == "Playing":
        icon = (
            f'<path d="M{ICON_X} 7.5 L{ICON_X} 17.5 L{ICON_X + 9.5} 12.5 Z" '
            f'fill="{PLAY_COL}"/>'
        )
        main_col = TITLE_COL
    else:
        icon = (
            f'<rect x="{ICON_X}" y="7.5" width="3.2" height="10" fill="{PAUSE_COL}"/>'
            f'<rect x="{ICON_X + 6.2}" y="7.5" width="3.2" height="10" '
            f'fill="{PAUSE_COL}"/>'
        )
        main_col = "#8F98A3"

    segs = [(title, main_col)]
    if artist and artist != title:
        segs.append(("  \u00b7  " + artist, ARTIST_COL))

    full_w = sum(text_w(t) for t, _ in segs)
    viewport_w = TITLE_END - TEXT_X

    if full_w > viewport_w:
        # 右端から流れ込み、最後まで見せたら折り返す(常に何か見える)
        travel = full_w - viewport_w
        enter_t = viewport_w / MARQUEE_SPEED
        elapsed = now - marquee_start
        if elapsed < enter_t:
            offset = elapsed * MARQUEE_SPEED
        else:
            duration = max(travel / MARQUEE_SPEED, 1.2)
            ph = ((elapsed - enter_t) % (2.0 * duration)) / duration
            d = travel * (ph if ph <= 1.0 else 2.0 - ph)
            offset = viewport_w + d
        x = TEXT_X + viewport_w - offset
    else:
        x = TEXT_X

    body = "".join(
        f'<tspan fill="{col}">{html.escape(text)}</tspan>' for text, col in segs
    )
    # cairo の toy API はフォールバックしないため、CJK を含む場合は
    # CJK 対応フォントを明示する
    has_cjk = any(ord(c) >= 0x2E80 for c in title + artist)
    family = "Noto Sans CJK JP" if has_cjk else "JetBrains Mono"
    text_svg = (
        f'<text x="{x:.2f}" y="16.7" font-family="{family}" '
        f'font-size="11.5">{body}</text>'
    )
    return icon, text_svg


def spectrum_svg(levels):
    """24バンドのスペアナを下から上へ描く。levels が None なら待機表示。"""
    rects = []
    for b in range(N_BANDS):
        lvl = levels[b] if levels else 0.0
        h_ = 1.8 + 17.2 * lvl
        x = WAVE_X + b * BAR_PITCH + (BAR_PITCH - BAR_W) / 2
        col = WAVE_IDLE_COL if lvl <= 0.01 else "url(#barGrad)"
        rects.append(
            f'<rect x="{x:.1f}" y="{SPECTRUM_BOTTOM - h_:.2f}" width="{BAR_W}" '
            f'height="{h_:.2f}" rx="1.7" fill="{col}"/>'
        )
    return "".join(rects)


def clock_svg(now):
    """20x20 のアナログ時計(時・分・秒針)を描く。"""
    size = 20.0
    c = size / 2.0
    r = 8.0
    lt = time.localtime(now)
    sec = lt.tm_sec + (now % 1.0)
    minute = lt.tm_min + sec / 60.0
    hour = (lt.tm_hour % 12) + minute / 60.0

    def hand(angle, length, width, color):
        a = math.radians(angle - 90.0)
        return (
            f'<line x1="{c:.2f}" y1="{c:.2f}" '
            f'x2="{c + length * math.cos(a):.2f}" '
            f'y2="{c + length * math.sin(a):.2f}" '
            f'stroke="{color}" stroke-width="{width}" stroke-linecap="round"/>'
        )

    return (
        f'<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" '
        f'viewBox="0 0 20 20">'
        f'<rect x="0" y="0" width="20" height="20" fill="{BG}"/>'
        f'<circle cx="{c}" cy="{c}" r="{r}" fill="none" stroke="#8F98A3" '
        f'stroke-width="1.1"/>'
        f'{hand(hour * 30.0, 4.2, 1.7, "#D8DEE9")}'
        f'{hand(minute * 6.0, 6.2, 1.2, "#D8DEE9")}'
        f'{hand(sec * 6.0, 7.0, 0.65, "#FFB300")}'
        f'<circle cx="{c}" cy="{c}" r="1.1" fill="#D8DEE9"/>'
        f'</svg>'
    )


# --------------------------------------------------
# メインループ (20Hz)
# --------------------------------------------------

try:
    _pydir = os.path.join(
        os.path.expanduser("~"), ".local/share/system-gauges-python"
    )
    if os.path.isdir(_pydir):
        sys.path.insert(0, _pydir)
    import cairosvg
except ImportError as exc:
    print(f"cairosvg unavailable: {exc}", file=sys.stderr)
    sys.exit(1)

cpu_meter = CpuMeter(os.path.join(runtime, "cpu.state"))
vram_cache = Cached(1.0, read_vram)
media_cache = Cached(1.0, read_media)

try:
    with open(os.path.join(runtime, "flip")) as f:
        completed = int(f.read().strip())
except (OSError, ValueError):
    completed = 0

TICK = 0.05

try:
    with open(os.path.join(runtime, "clock-flip")) as f:
        clock_flip = int(f.read().strip())
except (OSError, ValueError):
    clock_flip = 0

# 表示側の追加スムージング(データより滑らかに見せる)
display_levels = None

# メタデータが一時的に空になっても直前の表示を保持する(永続化つき)
last_media_path = os.path.join(runtime, "last_media")
sticky = None
STICKY_PLAYER_SECS = 3600.0
STICKY_GONE_SECS = 3.0
try:
    with open(last_media_path) as f:
        _parts = f.read().strip().split("\t")
    if len(_parts) >= 4 and _parts[1]:
        sticky = (_parts[0], _parts[1], _parts[2], _parts[3], time.time())
except (OSError, IndexError):
    pass

while True:
    loop_start = time.perf_counter()
    now = time.time()

    cpu = cpu_meter.read() or 0.0
    ram = read_ram()
    vram = vram_cache.get(now)
    media = media_cache.get(now)

    p_status, p_title, p_artist, p_art = "", "", "", ""
    if "|" in media:
        parts = media.split("|", 3)
        p_status = parts[0].strip()
        p_title = parts[1].strip() if len(parts) > 1 else ""
        p_artist = parts[2].strip() if len(parts) > 2 else ""
        p_art = parts[3].strip() if len(parts) > 3 else ""

    if p_title and p_status in ("Playing", "Paused"):
        if not sticky or (sticky[1], sticky[2], sticky[3]) != (p_title, p_artist, p_art):
            sticky = (p_status, p_title, p_artist, p_art, now)
            try:
                with open(last_media_path, "w") as f:
                    f.write("\t".join((p_status, p_title, p_artist, p_art)))
            except OSError:
                pass
        status, title, artist, art_url = sticky[0], sticky[1], sticky[2], sticky[3]
    elif sticky and now - sticky[4] <= (
        STICKY_PLAYER_SECS if p_status in ("Playing", "Paused") else STICKY_GONE_SECS
    ):
        status = p_status if p_status in ("Playing", "Paused") else sticky[0]
        title, artist, art_url = sticky[1], sticky[2], sticky[3]
    else:
        status, title, artist, art_url = "", "", "", ""

    if art_url != art_url_seen:
        art_url_seen = art_url
        if art_url:
            threading.Thread(target=_fetch_art, args=(art_url,), daemon=True).start()

    target_levels = read_spectrum(now) or [0.0] * N_BANDS
    if display_levels is None:
        display_levels = list(target_levels)
    else:
        display_levels = [
            d * 0.62 + t * 0.38 for d, t in zip(display_levels, target_levels)
        ]

    media_icon, media_text = media_parts(status, title, artist, now)

    # マーキーでタイトルが領域外へ出た分を背景色でマスクする
    mask_left = f'<rect x="0" y="0" width="{TEXT_X}" height="{H}" fill="{BG}"/>'
    mask_right = (
        f'<rect x="{TITLE_END}" y="0" width="{W - TITLE_END}" height="{H}" '
        f'fill="{BG}"/>'
    )

    art_uri = art_data_uri()
    art_svg = (
        f'<image x="{ART_X}" y="{ART_Y}" width="{ART_SIZE}" height="{ART_SIZE}" '
        f'xlink:href="{art_uri}"/>'
        if art_uri else ""
    )
    defs = (
        '<defs><linearGradient id="barGrad" x1="0" y1="0" x2="0" y2="1">'
        '<stop offset="0" stop-color="#E8FAFF"/>'
        '<stop offset="0.45" stop-color="#8FD2E8"/>'
        '<stop offset="1" stop-color="#4E8DA3"/>'
        '</linearGradient></defs>'
    )
    svg = (
        f'<svg xmlns="http://www.w3.org/2000/svg" '
        f'xmlns:xlink="http://www.w3.org/1999/xlink" '
        f'width="{W}" height="{H}" viewBox="0 0 {W} {H}">'
        f'{defs}'
        f'<rect x="0" y="0" width="{W}" height="{H}" fill="{BG}"/>'
        f'{media_text}'
        f'{mask_left}'
        f'{mask_right}'
        f'{art_svg}'
        f'{media_icon}'
        f'{ring(375, cpu, usage_color(cpu, CPU_BASE))}'
        f'{ring(410, ram, usage_color(ram, RAM_BASE))}'
        f'{ring(445, vram, usage_color(vram, VRAM_BASE))}'
        f'{spectrum_svg(display_levels)}'
        f'</svg>'
    )

    completed ^= 1
    target = os.path.join(runtime, f"gauge_{'b' if completed else 'a'}.png")
    tmp = target + ".part"
    try:
        cairosvg.svg2png(
            bytestring=svg.encode(), write_to=tmp,
            output_width=W, output_height=H,
        )
        os.replace(tmp, target)
        with open(os.path.join(runtime, "flip"), "w") as f:
            f.write(str(completed))
    except OSError:
        try:
            os.remove(tmp)
        except OSError:
            pass

    # アナログ時計 (20x20)
    clock_flip ^= 1
    clock_target = os.path.join(
        runtime, f"clock_{'b' if clock_flip else 'a'}.png"
    )
    clock_tmp = clock_target + ".part"
    try:
        cairosvg.svg2png(
            bytestring=clock_svg(now).encode(), write_to=clock_tmp,
            output_width=20, output_height=20,
        )
        os.replace(clock_tmp, clock_target)
        with open(os.path.join(runtime, "clock-flip"), "w") as f:
            f.write(str(clock_flip))
    except OSError:
        try:
            os.remove(clock_tmp)
        except OSError:
            pass

    time.sleep(max(0.0, TICK - (time.perf_counter() - loop_start)))
