#!/usr/bin/env bash

set -u

# eww system-gauges オーバーレイを起動する。
# 1) 波形キャプチャデーモン audio-wave-capture
# 2) ストリップレンダラ system-gauges-render (10Hz描画)
# を常駐させ、その後 eww ウィンドウを close → open で開く。

# 波形キャプチャデーモン(単一インスタンスはスクリプト自身が管理)
setsid nohup "$HOME/.local/bin/audio-wave-capture" \
    >>"$HOME/.cache/eww/wave.log" 2>&1 < /dev/null &
disown || true

# ストリップレンダラ(単一インスタンスは flock で管理)
setsid nohup "$HOME/.local/bin/system-gauges-render" \
    >>"$HOME/.cache/eww/render.log" 2>&1 < /dev/null &
disown || true
sleep 0.5

dir="$HOME/.config/eww/system-gauges"

if ! "$HOME/.local/bin/eww" -c "$dir" ping >/dev/null 2>&1; then
    setsid "$HOME/.local/bin/eww" -c "$dir" daemon \
        >/dev/null 2>&1 < /dev/null &
    disown || true
    sleep 1
fi

"$HOME/.local/bin/eww" -c "$dir" close system-gauges >/dev/null 2>&1 || true
sleep 0.2
"$HOME/.local/bin/eww" -c "$dir" open system-gauges >/dev/null 2>&1 || true
